---
import BaseLayout from "../layouts/BaseLayout.astro";

const skillGroups = [
	{
		title: "Languages",
		items: ["HTML", "CSS", "JavaScript", "TypeScript"],
	},
	{
		title: "Frameworks & Libraries",
		items: ["React", "Next.js", "Astro", "Tailwind CSS"],
	},
	{
		title: "Tools",
		items: ["Git", "Vite", "Figma"],
	},
];
---

<BaseLayout title="Skills | Wint Damrhung">
	<h1 class="text-3xl font-bold text-foreground">Skills</h1>
	<div class="mt-6 grid gap-8 sm:grid-cols-3">
		{
			skillGroups.map((group) => (
				<div>
					<h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
						{group.title}
					</h2>
					<ul class="mt-3 space-y-2">
						{group.items.map((item) => (
							<li class="text-foreground">{item}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</BaseLayout>
