---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
	{
		name: "Project One",
		description:
			"A short description of what this project does and the problem it solves.",
		tags: ["React", "TypeScript"],
		href: "#",
	},
	{
		name: "Project Two",
		description:
			"A short description of what this project does and the problem it solves.",
		tags: ["Astro", "Tailwind CSS"],
		href: "#",
	},
	{
		name: "Project Three",
		description:
			"A short description of what this project does and the problem it solves.",
		tags: ["Next.js", "Accessibility"],
		href: "#",
	},
];
---

<BaseLayout title="Projects | Wint Damrhung">
	<h1 class="text-3xl font-bold text-foreground">Projects</h1>
	<div class="mt-6 grid gap-6 sm:grid-cols-2">
		{
			projects.map((project) => (
				<a
					href={project.href}
					class="block rounded-lg border bg-card p-6 transition-colors hover:bg-muted"
				>
					<h2 class="font-semibold text-foreground">{project.name}</h2>
					<p class="mt-2 text-sm text-muted-foreground">
						{project.description}
					</p>
					<ul class="mt-4 flex flex-wrap gap-2">
						{project.tags.map((tag) => (
							<li class="rounded-full bg-muted px-2 py-1 text-xs text-muted-foreground">
								{tag}
							</li>
						))}
					</ul>
				</a>
			))
		}
	</div>
</BaseLayout>
