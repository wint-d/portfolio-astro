---
// import { Image } from "astro:assets";
// import portrait from "../assets/wint.jpg";
---

<section
	id="home"
	class="hero flex min-h-screen scroll-mt-24 flex-col justify-center gap-8 px-6"
	aria-labelledby="hero-name"
>
	<div class="mx-auto w-full max-w-6xl">
		<h1
			id="hero-name"
			class="text-left text-[10vw] font-extrabold uppercase leading-none tracking-tight"
		>
			<span class="text-transparent [-webkit-text-stroke:0.02em_#9ca3af]"
				>Wint</span
			>{" "}<span class="text-neutral-900">Damrhung</span>
		</h1>

		<div
			class="mt-10 flex flex-col items-center gap-10 md:flex-row md:justify-between"
		>
			<div
				class="flex flex-col items-center text-center md:items-start md:text-left"
			>
				<p class="role text-xl font-bold sm:text-2xl">
					Front-end Developer
				</p>
				<p class="tagline mt-2 max-w-xs text-neutral-500">
					Front-end developer crafting clean, fast interfaces.
				</p>

				<a
					href="#contact"
					class="mt-6 inline-flex items-center gap-2 rounded-full bg-neutral-900 px-5 py-3 text-sm font-medium text-white transition hover:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
				>
					Let's collaborate <span aria-hidden="true">↗</span>
				</a>
			</div>

			<figure class="hero-photo order-first md:order-none">
				<!-- <Image
					src={portrait}
					alt="Portrait of Wint Damrhung"
					widths={[288, 384, 768]}
					class="w-72 grayscale md:w-96"
					loading="eager"
				/> -->
			</figure>

			<aside aria-label="Social links">
				<ul class="flex flex-row flex-wrap justify-center gap-3">
					<li>
						<a
							href="#"
							class="inline-flex rounded-full border border-neutral-200 px-5 py-3 text-sm hover:bg-neutral-50"
							>GitHub</a>
					</li>
					<li>
						<a
							href="#"
							class="inline-flex rounded-full border border-neutral-200 px-5 py-3 text-sm hover:bg-neutral-50"
							>LinkedIn</a>
					</li>
				</ul>
			</aside>
		</div>
	</div>
</section>
